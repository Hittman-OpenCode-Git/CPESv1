      "certify": {"roles": [3,4,5], "description": "Certify items (question_state → 'Certified')"},
      "hold": {"roles": [3,4,5], "description": "Place items on HOLD"},
      "escalate": {"roles": [3,4,5], "description": "Escalate items to governance"}
