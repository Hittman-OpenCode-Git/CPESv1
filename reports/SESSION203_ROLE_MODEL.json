  "purpose": "Defines the complete role-based access control model for the May Administration Portal. Maps each role to its permissions, accessible modules, and data scope.",

  "role_hierarchy": {
    "description": "Roles are hierarchical — higher access levels inherit all lower-role permissions. Level 1 (Student) is the base. Level 5 (System Administrator) has unrestricted access.",
    "levels": [
      {"level": 1, "role": "Student", "inherits": []},
      {"level": 2, "role": "Content Administrator", "inherits": ["Student"]},
      {"level": 3, "role": "Certification Reviewer", "inherits": ["Content Administrator", "Student"]},
      {"level": 4, "role": "Governance Administrator", "inherits": ["Certification Reviewer", "Content Administrator", "Student"]},
      {"level": 5, "role": "System Administrator", "inherits": ["Governance Administrator", "Certification Reviewer", "Content Administrator", "Student"]}
    ]
  },

  "permission_catalog": {
