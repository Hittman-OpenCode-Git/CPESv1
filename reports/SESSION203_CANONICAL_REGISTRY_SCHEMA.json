{
  "document": "SESSION203_CANONICAL_REGISTRY_SCHEMA",
  "session": "S203",
  "title": "Canonical Registry Schema — JSON Data Contract",
  "series": "200-Series Process Engineering & Certification Architecture",
  "date": "2026-07-27",
  "type": "Data Contract Specification — Read-Only",
  "parent": "SESSION203_IDENTITY_ENGINE_SPEC.json (Identity Engine)",
  "purpose": "Defines the precise JSON schema for CANONICAL_REGISTRY.json and DELTA_LEDGER.json — the two persistent data stores that underpin the entire Framework v2 identity system. This schema is the contract that all engines, boards, agents, and tools must conform to.",

  "file_1_canonical_registry": {
    "file_path": "knowledge/CANONICAL_REGISTRY.json",
    "description": "The single source of truth for item identity. Contains one entry per unique compound key (i.e., per item variant). Indexed by identity_key for O(1) lookup.",
    "schema_version": "2.0.0",
    "governance_rules": [
      "Never hand-edited — generated by CanonicalRegistryEngine from pack file AM-1 parse",
      "Regenerated at session T0 and verified against dual grep for item count stability",
      "Must pass governance-guard Rule 10 (Registry Integrity) at T0, Tmid, and Tend",
      "Entry count must equal 2,500 (all 5 packs, 500 items each) after initial migration"
    ],

    "root_object": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": ["registry_version", "generated_by", "generated_at", "total_items", "indexes", "entries"],
      "properties": {
        "registry_version": {"type": "string", "const": "2.0.0"},
        "generated_by": {"type": "string", "const": "SESSION203 CanonicalRegistryEngine"},
        "generated_at": {"type": "string", "format": "date-time"},
        "total_items": {"type": "integer", "minimum": 0, "maximum": 5000},
        "indexes": {"$ref": "#/definitions/indexes"},
        "entries": {"$ref": "#/definitions/entries"}
      }
    },

    "definitions": {
      "indexes": {
        "type": "object",
        "description": "Three hash-map indexes for O(1) lookup. Rebuilt from entries on every load.",
        "properties": {
          "by_identity_key": {
            "type": "object",
            "description": "HashMap: identity_key (SHA-256 hex, 64 chars) → entry_index (integer offset into entries array). 2,500 entries at registration.",
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "by_qid_filepath": {
            "type": "object",
            "description": "HashMap: '{QID}|{File_Path}' → [entry_indices]. Supports QID-only lookup during transition (backward-compat shim).",
            "additionalProperties": {"type": "array", "items": {"type": "integer"}}
          },
          "by_template_family": {
            "type": "object",
            "description": "HashMap: '{Template_Family}' → [entry_indices]. Supports family-wide audits and clone detection.",
            "additionalProperties": {"type": "array", "items": {"type": "integer"}}
          }
        }
      },

      "entries": {
        "type": "array",
        "description": "Ordered array of registry entries. Array index is stable — indexes point into this array.",
        "items": {"$ref": "#/definitions/entry"}
      },

      "entry": {
        "type": "object",
        "required": [
          "identity_key", "compound_key", "components",
          "content_hash", "metadata_hash",
          "ew_profile", "question_state",
          "registered_at", "last_updated"
        ],
        "properties": {
          "identity_key": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hash of hashable_string: QID|CC|EWP|TF|FP. Stable across version changes (VersionID excluded). Primary lookup key."
          },
          "compound_key": {
            "type": "string",
            "pattern": "^P1[A-E]?-[A-F][CD]?-\\d{3}::[A-D]::[01]{4}::.+::pack_[a-e]_corrected\\.js:Section_[A-F]::\\d{14}-\\d+$",
            "description": "Full human-readable compound key: QID::CC::EWP::TF::FP::VID. Double-colon delimited."
          },
          "components": {
            "type": "object",
            "required": ["QID", "CC", "EW_Pattern", "Template_Family", "File_Path", "VersionID"],
            "properties": {
              "QID": {
                "type": "string",
                "pattern": "^P1[A-E]?-[A-F][CD]?-\\d{3}$",
                "description": "Question identifier. Pack-specific format; see Identity Engine spec for per-pack rules."
              },
              "CC": {
                "type": "string",
                "enum": ["A", "B", "C", "D"],
                "description": "CorrectChoice — the learner-facing correct answer letter."
              },
              "EW_Pattern": {
                "type": "string",
                "pattern": "^[01]{4}$",
                "description": "4-bit binary signature of ExplanationWrong emptiness. Position 0=A, 1=B, 2=C, 3=D. '0' = empty/absent, '1' = non-empty."
              },
              "Template_Family": {
                "type": "string",
                "minLength": 1,
                "description": "Rotation group identifier. Format: {SectionPrefix}_{concept}_{NNN} or 'STANDALONE_{QID}' or 'UNCLASSIFIED_{Section}_{hash}'."
              },
              "File_Path": {
                "type": "string",
                "enum": [
                  "pack_a_corrected.js:Section_A", "pack_a_corrected.js:Section_B",
                  "pack_a_corrected.js:Section_C", "pack_a_corrected.js:Section_D",
                  "pack_a_corrected.js:Section_E", "pack_a_corrected.js:Section_F",
                  "pack_b_corrected.js:Section_A", "pack_b_corrected.js:Section_B",
                  "pack_b_corrected.js:Section_C", "pack_b_corrected.js:Section_D",
                  "pack_b_corrected.js:Section_E", "pack_b_corrected.js:Section_F",
                  "pack_c_corrected.js:Section_A", "pack_c_corrected.js:Section_B",
                  "pack_c_corrected.js:Section_C", "pack_c_corrected.js:Section_D",
                  "pack_c_corrected.js:Section_E", "pack_c_corrected.js:Section_F",
                  "pack_d_corrected.js:Section_A", "pack_d_corrected.js:Section_B",
                  "pack_d_corrected.js:Section_C", "pack_d_corrected.js:Section_D",
                  "pack_d_corrected.js:Section_E", "pack_d_corrected.js:Section_F",
                  "pack_e_corrected.js:Section_A", "pack_e_corrected.js:Section_B",
                  "pack_e_corrected.js:Section_C", "pack_e_corrected.js:Section_D",
                  "pack_e_corrected.js:Section_E", "pack_e_corrected.js:Section_F"
                ],
                "description": "Pack file + section. Disambiguates cross-pack QID collisions."
              },
              "VersionID": {
                "type": "string",
                "pattern": "^\\d{14}-\\d+$",
                "description": "Content version identifier. Format: YYYYMMDDHHMMSS-increment. Increments on any content change."
              }
            }
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of canonical content fields (Stem + Choices + CC + EC + EW[A-D]). Used for delta review."
          },
          "metadata_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of metadata fields (Difficulty, CognitiveLevel, LOSTag, Topic, etc.). Changes trigger partial review."
          },
          "field_hashes": {
            "type": "object",
            "description": "Per-field SHA-256 hashes enabling field-level diff on content_hash mismatch.",
            "properties": {
              "stem_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "choices_a_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "choices_b_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "choices_c_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "choices_d_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "correct_choice_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "explanation_correct_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "explanation_wrong_a_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "explanation_wrong_b_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "explanation_wrong_c_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "explanation_wrong_d_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          },
          "ew_profile": {
            "type": "object",
            "required": ["pattern", "A_nonempty", "B_nonempty", "C_nonempty", "D_nonempty"],
            "properties": {
              "pattern": {"type": "string", "pattern": "^[01]{4}$"},
              "A_nonempty": {"type": "boolean"},
              "B_nonempty": {"type": "boolean"},
              "C_nonempty": {"type": "boolean"},
              "D_nonempty": {"type": "boolean"},
              "A_boilerplate": {"type": "boolean", "default": false},
              "B_boilerplate": {"type": "boolean", "default": false},
              "C_boilerplate": {"type": "boolean", "default": false},
              "D_boilerplate": {"type": "boolean", "default": false},
              "A_choice_specific": {"type": "boolean"},
              "B_choice_specific": {"type": "boolean"},
              "C_choice_specific": {"type": "boolean"},
              "D_choice_specific": {"type": "boolean"}
            }
          },
          "question_state": {
            "type": "string",
            "enum": ["Unprocessed", "In Audit", "Editorial Queue", "Certified", "Archived"],
            "description": "Governance state per QUESTION_METADATA_STANDARD.md §9. Gates learner-pool eligibility."
          },
          "parent_version_id": {
            "type": ["string", "null"],
            "pattern": "^\\d{14}-\\d+$",
            "description": "VersionID of the previous version. Null for first registration. Enables version chain traversal."
          },
          "replacement_of": {
            "type": ["string", "null"],
            "description": "QID of the item this replaces, with VersionID. Format: 'QID@VersionID'. Null if not a replacement."
          },
          "replaced_by": {
            "type": ["string", "null"],
            "description": "QID of the item that replaces this. Null if not replaced."
          },
          "quality_verdict": {
            "type": ["string", "null"],
            "enum": ["CERTIFY", "HOLD", "ESCALATE", null],
            "description": "Most recent certification board verdict. Null if never reviewed."
          },
          "dimension_scores": {
            "type": "object",
            "properties": {
              "D1_BP": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D2_Cog": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D3_Tech": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D4_Dist": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D5_Real": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D6_Num": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D7_Exp": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D8_Clarity": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D9_Acc": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
              "D10_Meta": {"type": ["integer", "null"], "minimum": 0, "maximum": 10}
            },
            "description": "CAQS 10-dimension scores. Null dimensions not yet scored."
          },
          "defect_flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "defect_id": {"type": "string", "pattern": "^DL-\\d{3}$"},
                "status": {"type": "string", "enum": ["Open", "Resolved", "False Positive"]},
                "detected_session": {"type": "string"},
                "resolved_session": {"type": ["string", "null"]}
              }
            },
            "description": "Known defect flags for this item. Updated as defects are found and resolved."
          },
          "certification_date": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "certification_batch": {
            "type": ["string", "null"]
          },
          "registered_at": {
            "type": "string",
            "format": "date-time"
          },
          "registered_by": {
            "type": "string"
          },
          "last_updated": {
            "type": "string",
            "format": "date-time"
          },
          "last_updated_by": {
            "type": "string"
          }
        }
      }
    },

    "example_entry": {
      "identity_key": "a3f8c2d1e4b5f6a7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1",
      "compound_key": "P1-AD-002::B::1011::AD_factoring_001::pack_d_corrected.js:Section_A::20260724144500-1",
      "components": {
        "QID": "P1-AD-002",
        "CC": "B",
        "EW_Pattern": "1011",
        "Template_Family": "AD_factoring_001",
        "File_Path": "pack_d_corrected.js:Section_A",
        "VersionID": "20260724144500-1"
      },
      "content_hash": "b4e5f6a7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4",
      "metadata_hash": "f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5",
      "field_hashes": {
        "stem_hash": "a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6",
        "choices_a_hash": "b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7",
        "choices_b_hash": "c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8",
        "choices_c_hash": "d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9",
        "choices_d_hash": "e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0",
        "correct_choice_hash": "f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1",
        "explanation_correct_hash": "a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2",
        "explanation_wrong_a_hash": "b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3",
        "explanation_wrong_b_hash": "c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4",
        "explanation_wrong_c_hash": "d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5",
        "explanation_wrong_d_hash": "e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6"
      },
      "ew_profile": {
