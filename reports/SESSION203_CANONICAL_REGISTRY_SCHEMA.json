      "last_updated": "2026-07-27T00:00:00Z",
      "last_updated_by": "S203-Identity-Migration"
    }
  },

  "file_2_delta_ledger": {
    "file_path": "knowledge/DELTA_LEDGER.json",
    "description": "Append-only ledger recording every content change, version update, and certification event. Enables delta review and full provenance tracing.",
    "schema_version": "2.0.0",
    "governance_rules": [
      "Append-only — entries are never modified or deleted",
      "Generated by LineageTracker on every content change or certification event",
      "Referenced by DeltaReviewEngine to determine which items need re-review",
      "Must remain consistent with CANONICAL_REGISTRY.json entry version history"
    ],

    "root_object": {
      "type": "object",
      "required": ["ledger_version", "generated_at", "entry_count", "entries"],
      "properties": {
        "ledger_version": {"type": "string", "const": "2.0.0"},
        "generated_at": {"type": "string", "format": "date-time"},
        "entry_count": {"type": "integer"},
        "entries": {"type": "array", "items": {"$ref": "#/delta_definitions/entry"}}
      }
    },

    "delta_definitions": {
      "entry": {
        "type": "object",
        "required": ["identity_key", "new_version_id", "new_content_hash", "change_type", "session_id", "timestamp"],
        "properties": {
          "identity_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "old_version_id": {"type": ["string", "null"], "pattern": "^\\d{14}-\\d+$"},
          "new_version_id": {"type": "string", "pattern": "^\\d{14}-\\d+$"},
          "old_content_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "new_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "change_type": {
            "type": "string",
            "enum": ["REGISTRATION", "CONTENT_CHANGED", "METADATA_CHANGED", "EW_ONLY", "RECERTIFY", "REPLACEMENT", "ARCHIVAL"]
          },
          "changed_fields": {"type": "array", "items": {"type": "string"}},
          "session_id": {"type": "string"},
          "timestamp": {"type": "string", "format": "date-time"},
          "quality_verdict": {"type": ["string", "null"], "enum": ["CERTIFY", "HOLD", "ESCALATE", null]},
          "evidence_package": {"type": ["string", "null"], "description": "File reference to session report with evidence"}
        }
      }
    },

    "example_entry": {
      "identity_key": "a3f8c2d1e4b5f6a7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1",
      "old_version_id": null,
      "new_version_id": "20260724144500-1",
      "old_content_hash": null,
      "new_content_hash": "b4e5f6a7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4",
      "change_type": "REGISTRATION",
      "changed_fields": [],
      "session_id": "S203",
      "timestamp": "2026-07-27T00:00:00Z",
      "quality_verdict": null,
      "evidence_package": "reports/SESSION203_IDENTITY_ENGINE_SPEC.json"
    }
  },

  "cross_file_integrity_rules": [
    {
      "rule": "CR-001 — Version Consistency",
      "description": "For every entry in CANONICAL_REGISTRY.json, the VersionID must match the latest DELTA_LEDGER.json entry's new_version_id for that identity_key."
    },
    {
      "rule": "CR-002 — Hash Consistency",
      "description": "For every entry in CANONICAL_REGISTRY.json, the content_hash must match the latest DELTA_LEDGER.json entry's new_content_hash for that identity_key."
    },
    {
      "rule": "CR-003 — Count Consistency",
      "description": "The number of entries in CANONICAL_REGISTRY.json must equal the number of unique identity_keys in DELTA_LEDGER.json with change_type = 'REGISTRATION' after initial migration."
    },
    {
      "rule": "CR-004 — Version Chain Integrity",
      "description": "For every DELTA_LEDGER entry with change_type != 'REGISTRATION', old_version_id must match some prior entry's new_version_id for the same identity_key."
    }
  ],

  "validation_script": {
    "file": "scripts/validate_registry_schema.js",
    "description": "Validates CANONICAL_REGISTRY.json and DELTA_LEDGER.json against this schema. Run at session T0, Tmid, and Tend per governance-guard Rule 10.",
    "checks": [
      "Schema conformance: all required fields present with correct types",
      "Identity key uniqueness: no duplicate identity_keys in registry entries",
      "Cross-file consistency: CR-001 through CR-004 verified",
      "Index integrity: all 3 indexes rebuilt from entries and match entry count",
      "QID format validation: all QIDs match expected per-pack patterns",
      "EW_Pattern accuracy: rebuilt from source files via AM-1 parse → compared to stored patterns",
      "Count stability: entry count stable across 2 independent re-extractions"
    ]
  }
}