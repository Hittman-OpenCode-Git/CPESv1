      "defect_flags": [
        {"defect_id": "DL-026", "status": "Open", "detected_session": "S202", "resolved_session": null}
      ],
      "certification_date": null,
      "certification_batch": null,
      "registered_at": "2026-07-27T00:00:00Z",
