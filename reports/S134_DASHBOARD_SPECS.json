  "dashboards": {
    "governance": {
      "title": "Governance Dashboard",
      "description": "Governance health, certified inventory, rule enforcement, open defects, and portfolio drift",
      "refreshHint": "Data from domain_progress.json + readiness_scoring.json + admin_dashboard_data.js",
      "cards": [
        {
          "id": "gov-health",
          "title": "Governance Health",
          "type": "stat-grid",
          "gridColumn": "span 4",
          "columns": 2,
          "dataBindings": [
            { "field": "overall.certified", "source": "domain_progress.json", "type": "integer", "label": "Certified", "format": "number" },
            { "field": "overall.ready", "source": "domain_progress.json", "type": "integer", "label": "Ready", "format": "number" },
            { "field": "overall.remediate", "source": "domain_progress.json", "type": "integer", "label": "Remediate", "format": "number" },
            { "field": "portfolioReadiness.byState.BLOCKED", "source": "readiness_scoring.json", "type": "integer", "label": "Blocked", "format": "number" },
            { "field": "overall.coveragePct", "source": "domain_progress.json", "type": "number", "label": "Coverage", "format": "percent" },
            { "field": "portfolioReadiness.readinessScore", "source": "readiness_scoring.json", "type": "string", "label": "Readiness", "format": "number2dp" }
          ]
        },
        {
          "id": "gov-certified-inventory",
          "title": "Certified Inventory by Domain",
          "type": "progress-bar-list",
          "gridColumn": "span 4",
          "dataBindings": [
            { "field": "byDomain.{domain}.certified", "source": "domain_progress.json", "type": "integer", "label": "Certified", "iterate": "A,B,C,D,E,F" },
            { "field": "byDomain.{domain}.total", "source": "domain_progress.json", "type": "integer", "label": "Total", "iterate": "A,B,C,D,E,F" },
            { "field": "byDomain.{domain}.coveragePct", "source": "domain_progress.json", "type": "number", "label": "Coverage", "iterate": "A,B,C,D,E,F" },
            { "field": "byDomain.{domain}.domainName", "source": "domain_progress.json", "type": "string", "label": "Domain", "iterate": "A,B,C,D,E,F" },
            { "field": "byDomain.{domain}.remainingToCertify", "source": "domain_progress.json", "type": "integer", "label": "Remaining", "iterate": "A,B,C,D,E,F" }
          ]
        },
        {
          "id": "gov-rule-enforcement",
          "title": "Rule Enforcement Status",
          "type": "rule-table",
          "gridColumn": "span 4",
          "dataBindings": [
            { "field": "metadata.governanceGuardStatus", "source": "admin_dashboard_data.js", "type": "string", "label": "Guard Status", "format": "text" }
          ],
          "staticRules": [
            { "id": "RULE_1", "name": "question_state + REVISION_HISTORY pairing", "level": "BLOCK" },
            { "id": "RULE_2", "name": "ExplanationWrong[CorrectChoice] non-empty", "level": "BLOCK" },
            { "id": "RULE_3", "name": "MASTER_QUESTION_REGISTRY generated-only", "level": "BLOCK" },
            { "id": "RULE_4", "name": "Answer-key changes require recomputed note", "level": "BLOCK" },
            { "id": "RULE_5", "name": "Max 30 question objects per change-set", "level": "BLOCK" },
            { "id": "RULE_6", "name": "non-CorrectChoice ExplanationWrong non-empty", "level": "BLOCK" },
            { "id": "RULE_7", "name": "No hand-editing derived registries", "level": "BLOCK" },
            { "id": "RULE_8", "name": "Session packages must be registered", "level": "BLOCK" },
            { "id": "RULE_9", "name": "Choice binary lead-in polarity mismatch", "level": "BLOCK" },
            { "id": "RULE_10", "name": "non-CorrectChoice ExplanationWrong present+non-empty", "level": "BLOCK" }
          ]
        },
        {
          "id": "gov-open-defects",
          "title": "Open Defect Summary",
          "type": "stat-grid-with-detail",
          "gridColumn": "span 4",
          "dataBindings": [
            { "field": "perDomain.{domain}.blocked", "source": "readiness_scoring.json", "type": "integer", "label": "Blocked", "iterate": "A,B,C,D,E,F" },
            { "field": "perDomain.{domain}.remediate", "source": "readiness_scoring.json", "type": "integer", "label": "Remediate", "iterate": "A,B,C,D,E,F" },
            { "field": "perPack.{pack}.BLOCKED", "source": "readiness_scoring.json", "type": "integer", "label": "Blocked", "iterate": "pack_a,pack_b,pack_c,pack_d,pack_e" },
            { "field": "perPack.{pack}.REMEDIATE", "source": "readiness_scoring.json", "type": "integer", "label": "Remediate", "iterate": "pack_a,pack_b,pack_c,pack_d,pack_e" }
          ]
        },
        {
          "id": "gov-portfolio-drift",
          "title": "Portfolio Drift Alerts",
          "type": "alert-list",
          "gridColumn": "span 4",
          "dataDriven": false,
          "description": "Computed at render time by comparing S121 distributions against S121_PORTFOLIO_TARGETS.md immutable targets. Flags per-pack dimensions where |actual% - target%| > 5pp.",
          "dataBindings": [
            { "field": "packs[N].difficulty.*", "source": "S121_PORTFOLIO_DASHBOARD.json", "label": "Difficulty per pack" },
            { "field": "packs[N].cognitive.*", "source": "S121_PORTFOLIO_DASHBOARD.json", "label": "Cognitive per pack" },
            { "field": "packs[N].correctChoice.*", "source": "S121_PORTFOLIO_DASHBOARD.json", "label": "Answer position per pack" }
          ]
        }
      ]
    },
    "portfolio": {
      "title": "Portfolio Dashboard",
      "description": "Difficulty balance, cognitive balance, answer position balance, domain coverage, and LOS coverage",
      "refreshHint": "Data from S121_PORTFOLIO_DASHBOARD.json",
      "cards": [
        {
          "id": "port-difficulty",
          "title": "Difficulty Distribution",
          "type": "stacked-bar-chart",
          "gridColumn": "span 4",
          "description": "Target vs. actual difficulty distribution per pack",
          "dataBindings": [
            { "field": "packs[N].difficulty.*", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "object", "keys": ["Easy","Moderate-Easy","Moderate","Difficult","Very Difficult"] },
            { "field": "packs[N].name", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "string" },
            { "field": "packs[N].totalItems", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "integer" }
          ],
          "targetPercentages": {
            "Easy": 15, "Moderate-Easy": 20, "Moderate": 30, "Difficult": 25, "Very Difficult": 10
          },
          "renderHint": "Stacked horizontal bar: 5 packs × 5 difficulty tiers. Each bar shows actual%. Overlay target% as vertical line markers. Highlight bars where any tier exceeds ±5pp drift."
        },
        {
          "id": "port-cognitive",
          "title": "Cognitive Level Distribution",
          "type": "stacked-bar-chart",
          "gridColumn": "span 4",
          "description": "Target vs. actual cognitive level distribution per pack",
          "dataBindings": [
            { "field": "packs[N].cognitive.*", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "object", "keys": ["Remember","Understand","Apply","Analyze","Evaluate"] },
            { "field": "packs[N].name", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "string" },
            { "field": "packs[N].totalItems", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "integer" }
          ],
          "targetPercentages": {
            "Remember": 5, "Understand": 15, "Apply": 40, "Analyze": 25, "Evaluate": 15
          },
          "renderHint": "Stacked horizontal bar: 5 packs × 5 cognitive tiers. Show (missing) items as a separate grey segment if present. Highlight packs where Analyze+Evaluate < 30%."
        },
        {
          "id": "port-answer-position",
          "title": "Answer Position Balance",
          "type": "radial-bar-group",
          "gridColumn": "span 2",
          "description": "CorrectChoice distribution across A/B/C/D per pack",
          "dataBindings": [
            { "field": "packs[N].correctChoice.*", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "object", "keys": ["A","B","C","D"] },
            { "field": "packs[N].name", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "string" }
          ],
          "targetRange": { "min": 22, "max": 28 },
          "renderHint": "5 radial mini-bars (one per pack). Each shows A/B/C/D as 4 segments within 22-28% target band. Highlight positions outside 22-28%."
        },
        {
          "id": "port-domain-coverage",
          "title": "Domain Coverage",
          "type": "heatmap-table",
          "gridColumn": "span 4",
          "description": "Per-pack × per-section certified coverage matrix",
          "dataBindings": [
            { "field": "bySection[N].certified", "source": "domain_progress.json", "type": "integer" },
            { "field": "bySection[N].total", "source": "domain_progress.json", "type": "integer" },
            { "field": "bySection[N].pack", "source": "domain_progress.json", "type": "string" },
            { "field": "bySection[N].section", "source": "domain_progress.json", "type": "string" }
          ],
          "renderHint": "5×6 heatmap: rows=packs (A-E), columns=sections (A-F). Each cell shows certified/total with color gradient: grey (<70%), amber (70-89%), green (90-99%), blue (100%)."
        },
        {
          "id": "port-pool-overview",
          "title": "Pool Overview",
          "type": "stat-comparison",
          "gridColumn": "span 4",
          "description": "Part 1 vs. Part 2 comparison cards",
          "dataBindings": [
            { "field": "pools.part1.totalItems", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "integer", "label": "Part 1 Items" },
            { "field": "pools.part1.certified", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "integer", "label": "Part 1 Certified" },
            { "field": "pools.part2.totalItems", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "integer", "label": "Part 2 Items" },
            { "field": "pools.part2.certified", "source": "S121_PORTFOLIO_DASHBOARD.json", "type": "integer", "label": "Part 2 Certified" }
          ],
          "renderHint": "Two-column comparison. Left: Part 1 stat cards (total, certified ratio, difficulty distribution donut, cognitive bar). Right: Part 2 same layout."
        }
      ]
    },
