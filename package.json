{
  "name": "cma-part-1-exam-simulator",
  "version": "1.1.0",
  "description": "CMA Part 1 Exam Simulator & Question Repository",
  "private": true,
  "main": "main.js",
  "scripts": {
    "validate": "node scripts/validate.js",
    "registry": "node scripts/build_master_registry.js",
    "audit": "node scripts/section_a_validation_batch.js",
    "dashboard": "node scripts/build_dashboard.js",
    "build-registry": "node scripts/build_master_registry.js && node scripts/generate_registry.js",
    "generate-registry": "node scripts/generate_registry.js",
    "pipeline": "npm run validate && npm run build-registry && npm run dashboard",
    "preflight": "node scripts/preflight.js",
    "smoke": "node scripts/smoke_test.js",
    "electron": "electron .",
    "electron-dev": "electron . --dev"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "playwright": "^1.61.1"
  }
}
